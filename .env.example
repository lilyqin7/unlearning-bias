# 1) Colab: GPU runtime, run self-hosted-inference/server.py + ngrok on port 8000.
# 2) Paste ngrok HTTPS origin (no trailing path) into INFERENCE_API_URL.
# 3) LORA_WEIGHTS_URL = Hugging Face → file → ⋮ → Copy download link (.safetensors).
# 4) npm run dev → http://localhost:3000

INFERENCE_API_URL=https://your-subdomain.ngrok-free.app
INFERENCE_API_NGROK_SKIP_BROWSER_WARNING=1
LORA_WEIGHTS_URL=https://huggingface.co/you/repo/resolve/main/your-lora.safetensors
IMAGE_GENERATION_BACKEND=self